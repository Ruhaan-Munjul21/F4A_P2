# Firebase Configuration
# Get these values from your Firebase Console: https://console.firebase.google.com

# Firebase Web SDK Configuration
# Found in Firebase Console > Project Settings > General > Your apps > Web app
FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Firebase Admin SDK Service Account Key
# Found in Firebase Console > Project Settings > Service Accounts > Generate new private key
# Convert the downloaded JSON to a single line string and paste here
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# Database Configuration (if using Neon/PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Session Secret (for authentication if needed)
SESSION_SECRET=your-session-secret-here